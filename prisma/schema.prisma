generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  email                 String?   @unique
  mobile                String?   @unique
  name                  String
  role                  String
  userType              String
  status                String
  plan                  String
  loginIdentifier       String?
  credentialHash        String?
  /// MVP only. Production should store a salted password/PIN hash, never a plain temporary PIN.
  tempPin               String?
  mustChangeCredentials Boolean   @default(false)
  approvedAt            DateTime?
  approvedBy            String?
  lastLoginAt           DateTime?
  dailyAiLimit          Int       @default(3)
  uploadLimit           Int       @default(0)
  canDownloadMaterials  Boolean   @default(false)
  canUploadMaterials    Boolean   @default(false)
  canUseAI              Boolean   @default(true)
  canUseOCR             Boolean   @default(false)
  canImportFromDrive    Boolean   @default(false)
  canIndexMaterials     Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  children        Child[]
  accessRequests  AccessRequest[]
  usages          AiUsage[]
  progress        Progress[]
  quizResults     QuizResult[]
  uploads         UploadMaterial[]
  subscriptions   Subscription[]
  adminActions    AdminAction[]    @relation("AdminActionsByUser")
  targetActions   AdminAction[]    @relation("AdminActionsForUser")
  studentSubjects StudentSubject[]

  @@index([status])
  @@index([email])
  @@index([loginIdentifier])
}

model Child {
  id                           String   @id @default(cuid())
  userId                       String?
  childId                      String?
  name                         String
  grade                        String
  classNumber                  Int?
  board                        String?
  preferredLanguage            String?
  r1Language                   String?
  r2Language                   String?
  r3Language                   String?
  regionalLanguage             String?
  selectedLanguages            Json?
  submittedSubjects            Json?
  cbseLanguageRuleWarning      String?
  cbseLanguageValidationStatus String?
  weakSubjects                 String?
  learningGoal                 String?
  // Student login fields
  studentLoginId               String?  @unique
  studentPasswordHash          String?
  mustChangeStudentPassword    Boolean  @default(true)
  studentLoginEnabled          Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentSubjects StudentSubject[]

  @@index([userId])
  @@index([childId])
  @@index([studentLoginId])
}

model AccessRequest {
  id                           String    @id @default(cuid())
  parentName                   String
  email                        String    @unique
  mobile                       String
  state                        String?
  city                         String?
  preferredLanguage            String?
  childName                    String
  grade                        String
  classNumber                  Int?
  board                        String?
  preferredExplanationLanguage String?
  r1Language                   String?
  r2Language                   String?
  r3Language                   String?
  regionalLanguage             String?
  selectedLanguages            Json?
  submittedSubjects            Json?
  submittedChildren            Json?
  cbseLanguageRuleWarning      String?
  cbseLanguageValidationStatus String?
  weakSubjects                 String?
  learningGoal                 String?
  status                       String    @default("pending")
  role                         String    @default("parent")
  userType                     String    @default("externalUser")
  plan                         String    @default("demo")
  loginIdentifier              String?
  expiryDate                   DateTime?
  dailyAiLimit                 Int       @default(3)
  uploadLimit                  Int       @default(0)
  ocrLimit                     Int       @default(0)
  visualLessonLimit            Int       @default(2)
  quizGenerationLimit          Int       @default(1)
  maxChildren                  Int       @default(1)
  tempPin                      String?
  credentialHash               String?
  mustChangeCredentials        Boolean   @default(true)
  tempCredentialsIssuedAt      DateTime?
  canDownloadMaterials         Boolean   @default(false)
  canUploadMaterials           Boolean   @default(false)
  canUseAI                     Boolean   @default(false)
  canUseOCR                    Boolean   @default(false)
  canImportFromDrive           Boolean   @default(false)
  canIndexMaterials            Boolean   @default(false)
  userId                       String?
  approvedAt                   DateTime?
  approvedBy                   String?
  rejectedAt                   DateTime?
  blockedAt                    DateTime?
  lastLoginAt                  DateTime?
  loginEmailSentAt             DateTime?
  loginEmailStatus             String?
  loginEmailError              String?
  adminNotes                   String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  adminActions    AdminAction[]
  studentSubjects StudentSubject[]

  @@index([status])
  @@index([email])
  @@index([userId])
}

model StudentSubject {
  id                  String   @id @default(cuid())
  userId              String?
  childId             String?
  accessRequestId     String?
  subjectName         String
  subjectType         String
  languageRole        String?
  language            String?
  publisher           String
  bookTitle           String?
  medium              String?
  autoDownloadAllowed Boolean  @default(false)
  sourceStatus        String   @default("pending")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  child         Child?         @relation(fields: [childId], references: [id], onDelete: SetNull)
  accessRequest AccessRequest? @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([childId])
  @@index([accessRequestId])
  @@index([subjectName])
  @@index([sourceStatus])
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  actorKey  String
  dateKey   String
  feature   String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([actorKey, dateKey, feature])
  @@index([userId])
  @@index([dateKey])
}

model UploadMaterial {
  id                 String   @id @default(cuid())
  userId             String?
  childId            String?
  childName          String?
  grade              String?
  subject            String
  materialType       String
  chapter            String?
  topic              String?
  title              String
  originalFileName   String
  storedFileName     String?
  mimeType           String?
  sizeBytes          Int?
  sizeLabel          String?
  source             String
  originalSourceUrl  String?
  bookTitle          String?
  chapterNumber      Int?
  status             String
  indexStatus        String?
  indexError         String?
  ocrStatus          String?
  canDownload        Boolean  @default(false)
  internalFamilyOnly Boolean  @default(false)
  storagePath        String?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  chunks IndexedChunk[]

  @@index([userId, subject])
  @@index([childId])
  @@index([status])
}

model IndexedChunk {
  id            String   @id @default(cuid())
  materialId    String?
  userId        String?
  childId       String?
  subject       String
  title         String?
  chunkIndex    Int
  content       String
  source        String?
  bookTitle     String?
  chapterNumber Int?
  metadata      Json?
  createdAt     DateTime @default(now())

  material UploadMaterial? @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
  @@index([materialId])
  @@index([childId])
}

model Progress {
  id               String    @id @default(cuid())
  userId           String?
  childId          String
  subject          String
  lessonsCompleted Int       @default(0)
  topicsRevised    Int       @default(0)
  quizzesAttempted Int       @default(0)
  starsEarned      Int       @default(0)
  streakCount      Int       @default(0)
  lastActiveDate   DateTime?
  weakConcepts     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, childId, subject])
  @@index([childId])
}

model QuizResult {
  id           String   @id @default(cuid())
  userId       String?
  childId      String
  subject      String
  quizTitle    String?
  score        Int
  total        Int
  percentage   Float
  weakConcepts Json?
  answers      Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([childId, subject])
}

model WeakConcept {
  id        String   @id @default(cuid())
  userId    String?
  childId   String
  subject   String
  concept   String
  severity  String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([childId, subject])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String
  plan          String
  status        String
  startsAt      DateTime?
  expiresAt     DateTime?
  dailyAiLimit  Int
  uploadLimit   Int
  paymentStatus String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AdminAction {
  id              String   @id @default(cuid())
  adminUserId     String?
  targetUserId    String?
  targetRequestId String?
  action          String
  notes           String?
  metadata        Json?
  createdAt       DateTime @default(now())

  adminUser     User?          @relation("AdminActionsByUser", fields: [adminUserId], references: [id], onDelete: SetNull)
  targetUser    User?          @relation("AdminActionsForUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetRequest AccessRequest? @relation(fields: [targetRequestId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([targetRequestId])
}

model DiagnosticResult {
  id                    String   @id @default(cuid())
  userId                String?
  childId               String
  grade                 String
  subject               String
  score                 Int
  total                 Int
  percentage            Float
  weakAreas             Json?
  strongAreas           Json?
  recommendedStartLevel String?
  actualLearningLevel   String?
  gradeReadinessPercentage Float?
  recommendedStartingPoint String?
  foundationRecoveryRequired Boolean @default(false)
  readingLevel          String?
  writingLevel          String?
  numberRecognitionLevel String?
  arithmeticLevel       String?
  subjectFoundationLevel String?
  classLevelReadiness   String?
  learningSpeed         String?
  mistakePatterns       Json?
  domainLevels          Json?
  learningPlan          Json?
  riskLevel             String?
  answers               Json?
  completedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([childId, subject])
  @@index([completedAt])
}

model ChapterReadinessResult {
  id                             String   @id @default(cuid())
  userId                         String?
  childId                        String
  subject                        String
  chapter                        String
  readinessStatus                String
  score                          Int
  total                          Int
  percentage                     Float
  weakPrerequisites              Json?
  recommendedPrerequisiteLessons Json?
  answers                        Json?
  createdAt                      DateTime @default(now())

  @@index([userId])
  @@index([childId, subject, chapter])
}

model ChapterMastery {
  id            String    @id @default(cuid())
  userId        String?
  childId       String
  subject       String
  chapter       String
  masteryScore  Float     @default(0)
  status        String    @default("locked")
  attempts      Int       @default(0)
  weakConcepts  Json?
  lastAttemptAt DateTime?
  masteredAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([childId, subject, chapter])
  @@index([userId])
  @@index([childId, subject])
  @@index([status])
}

model RevisionTask {
  id          String    @id @default(cuid())
  userId      String?
  childId     String
  subject     String
  chapter     String?
  concept     String
  taskType    String
  status      String    @default("pending")
  dueOn       DateTime?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([childId, subject])
  @@index([status])
}

model BacklogPlan {
  id           String    @id @default(cuid())
  userId       String?
  childId      String
  subject      String
  chapter      String
  weakConcepts Json?
  dailyPlan    Json?
  status       String    @default("active")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([childId, subject, chapter])
  @@index([status])
}

model HomeworkSubmission {
  id          String    @id @default(cuid())
  userId      String?
  childId     String
  subject     String?
  chapter     String?
  topic       String?
  imageUrl    String?
  filePath    String?
  ocrText     String?
  ocrStatus   String    @default("pending")
  status      String    @default("submitted")
  score       Float?
  feedback    Json?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([childId, subject])
  @@index([status])
}

model ExamPlan {
  id              String    @id @default(cuid())
  userId          String?
  childId         String
  examName        String
  examDate        DateTime?
  subjects        Json?
  chapters        Json?
  weightage       Json?
  portionImageUrl String?
  readinessScore  Float?
  dailyPlan       Json?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([childId])
  @@index([examDate])
}

model LearningPath {
  id                         String   @id @default(cuid())
  userId                     String?
  childId                    String
  enrolledGrade              String
  actualLearningLevel        String
  currentPhase               String
  recommendedStartingPoint   String
  gradeReadinessPercentage   Float    @default(0)
  foundationRecoveryRequired Boolean  @default(false)
  targetScore                Float    @default(95)
  dailyAvailableMinutes      Int      @default(45)
  status                     String   @default("active")
  foundationTopics           Json?
  bridgeTopics               Json?
  classSyllabusTopics        Json?
  revisionTopics             Json?
  mockTestSchedule           Json?
  weakTopicRepairLoop        Json?
  todayPlan                  Json?
  weeklyPlan                 Json?
  metadata                   Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([userId])
  @@index([childId])
  @@index([status])
}

model TopicMastery {
  id                  String    @id @default(cuid())
  userId              String?
  childId             String
  subject             String
  chapter             String?
  topic               String
  status              String    @default("Not started")
  diagnosticScore     Float?
  quizScore           Float?
  retryCount          Int       @default(0)
  timeSpentMinutes    Int       @default(0)
  mistakesRepeated    Json?
  revisionScore       Float?
  mockTestScore       Float?
  masteryScore        Float     @default(0)
  nextAction          String?
  prerequisiteTopic   String?
  lastPracticedAt     DateTime?
  examReadyAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([childId, subject, chapter, topic])
  @@index([userId])
  @@index([childId, subject])
  @@index([status])
}

model PracticeAttempt {
  id               String   @id @default(cuid())
  userId           String?
  childId          String
  subject          String
  chapter          String?
  topic            String
  attemptType      String
  score            Float
  total            Float
  percentage       Float
  timeSpentMinutes Int      @default(0)
  retryCount       Int      @default(0)
  mistakes         Json?
  actionTaken      String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([childId, subject, topic])
  @@index([createdAt])
}

model ExamReadinessPlan {
  id                         String    @id @default(cuid())
  userId                     String?
  childId                    String
  examName                   String    @default("Annual Exam")
  targetScore                Float     @default(95)
  examDate                   DateTime?
  currentReadinessPercentage Float     @default(0)
  predictedScore             Float     @default(0)
  dailyAvailableMinutes      Int       @default(45)
  syllabusSize               Int       @default(0)
  weakTopics                 Json?
  topicsBlockingTarget       Json?
  dailyStudyPlan             Json?
  weeklyRevisionPlan         Json?
  mockTestSchedule           Json?
  readinessBySubject         Json?
  status                     String    @default("active")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([userId])
  @@index([childId])
  @@index([examDate])
  @@index([status])
}
